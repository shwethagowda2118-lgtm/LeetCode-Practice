class Solution(object):
    def isMatch(self, s, p):
        """
        :type s: str
        :type p: str
        :rtype: bool
        """
        m, n = len(s), len(p)
        # dp[i][j] represents if s[:i] matches p[:j]
        dp = [[False] * (n + 1) for _ in range(m + 1)]
        dp[0][0] = True

        # Handle patterns like a*, a*b*, .* matching an empty string s
        for j in range(2, n + 1):
            if p[j - 1] == '*':
                dp[0][j] = dp[0][j - 2]

        for i in range(1, m + 1):
            for j in range(1, n + 1):
                if p[j - 1] == '*':
                    # 1. Zero occurrences of the preceding element
                    zero_occ = dp[i][j - 2]
                    # 2. One or more occurrences (if preceding char matches s[i - 1])
                    one_or_more = (p[j - 2] in (s[i - 1], '.')) and dp[i - 1][j]
                    dp[i][j] = zero_occ or one_or_more
                elif p[j - 1] in (s[i - 1], '.'):
                    dp[i][j] = dp[i - 1][j - 1]

        return dp[m][n]
