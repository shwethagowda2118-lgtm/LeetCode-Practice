class Solution(object):
    def isPalindrome(self, x):
        """
        :type x: int
        :rtype: bool
        """
        # Negative numbers are not palindromes; numbers ending in 0
        # (except 0 itself) cannot be palindromes.
        if x < 0 or (x % 10 == 0 and x != 0):
            return False

        reverted_half = 0
        while x > reverted_half:
            reverted_half = reverted_half * 10 + x % 10
            x //= 10

        # Even digits: x == reverted_half (e.g., 1221 -> x=12, reverted_half=12)
        # Odd digits: x == reverted_half // 10 (e.g., 121 -> x=1, reverted_half=12)
        return x == reverted_half or x == reverted_half // 10
